# Copy this file outside version control as .env.production and replace every placeholder.
GAME_SERVER_IMAGE=registry.example.com/game01/server:2026.09.01
GAME_HTTP_PORT=8080

# These values must be unique for every replica across all service roles.
GAME_GATEWAY_INSTANCE_ID=gateway-prod-01
GAME_GATEWAY_ID_NODE_ID=1
GAME_GATEWAY_GRPC_ADVERTISE_ADDRESS=gateway-prod-01.game01-private:9090
GAME_USERCENTER_INSTANCE_ID=usercenter-prod-01
GAME_USERCENTER_ID_NODE_ID=2
GAME_USERCENTER_GRPC_ADVERTISE_ADDRESS=usercenter-prod-01.game01-private:9090
GAME_LOBBY_INSTANCE_ID=lobby-prod-01
GAME_LOBBY_ID_NODE_ID=3
GAME_LOBBY_GRPC_ADVERTISE_ADDRESS=lobby-prod-01.game01-private:9090
GAME_BATTLE_INSTANCE_ID=battle-prod-01
GAME_BATTLE_ID_NODE_ID=4
GAME_BATTLE_GRPC_ADVERTISE_ADDRESS=battle-prod-01.game01-private:9090

# Use internal addresses only. Put secret values in the deployment secret store.
GAME_REDIS_ADDR=redis.game01-private:6379
GAME_REDIS_PASSWORD=replace-with-redis-secret
GAME_MONGO_URI=mongodb://game_user:replace-with-mongo-secret@mongo.game01-private:27017/?authSource=admin
GAME_MONGO_DATABASE=game01
GAME_MONGO_AUTH_MECHANISM=SCRAM-SHA-256
GAME_MONGO_AUTH_SOURCE=admin
GAME_DISCOVERY_ENDPOINTS=etcd-01.game01-private:2379,etcd-02.game01-private:2379,etcd-03.game01-private:2379
GAME_DOCKER_NETWORK=game01-private
